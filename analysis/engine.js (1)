/*
 * ============================================================
 * GTRADER-ME ENGINE
 * Integrated analysis coordinator
 * ============================================================
 *
 * This is ONE file.
 *
 * It coordinates:
 * patterns.js
 * probability.js
 * statistics.js
 * transition.js
 * markov.js
 * cycle.js
 * confidence.js
 * validator.js
 * decision.js
 * learning.js
 *
 * It does NOT duplicate their analysis.
 * ============================================================
 */

(function (global) {

    "use strict";

    class AnalysisEngine {

        constructor(options = {}) {

            this.version = "3.0.0";

            this.config = Object.assign({

                maxTicks: 1000,

                analysisWindow: 200,

                minAnalysisTicks: 30,

                minTradeConfidence: 90,

                startingBalance: 5,

                maxStake: 5,

                paperTrading: true,

                liveTrading: false,

                autoSelectMarket: true,

                markets: [
                    "R_10",
                    "R_25",
                    "R_75",
                    "R_100",
                    "1HZ10V",
                    "1HZ25V",
                    "1HZ75V",
                    "1HZ100V"
                ]

            }, options);


            this.started = false;

            this.paused = false;

            this.destroyed = false;


            this.markets =
                [...this.config.markets];

            this.activeMarket =
                this.markets[0];


            this.listeners =
                new Set();


            this.modules =
                {};


            this.analysis =
                {};


            this.marketStates =
                {};


            this.pendingSignals =
                {};


            this.lastError =
                null;


            this.memory = {

                ticks: [],

                digits: [],

                frequencies:
                    Array(10).fill(0),

                lastDigit: null,

                previousDigit: null
            };


            this.paper = {

                enabled:
                    !!this.config.paperTrading,

                balance:
                    Number(
                        this.config.startingBalance
                    ) || 0,

                initialBalance:
                    Number(
                        this.config.startingBalance
                    ) || 0,

                profit: 0,

                wins: 0,

                losses: 0,

                trades: 0,

                lastTrade: null
            };


            this.tradeHistory =
                [];


            this.initializeMarkets();

            this.loadExternalModules();

        }


        /* ======================================================
         * INITIALIZATION
         * ====================================================== */

        initialize() {

            if (this.started) {

                return this.getState();

            }


            this.started =
                true;

            this.paused =
                false;


            for (
                const market of this.markets
            ) {

                this.ensureMarketState(
                    market
                );

            }


            this.analyzeAllMarkets();

            this.emit(true);


            return this.getState();
        }


        start() {

            this.destroyed =
                false;

            this.started =
                true;

            this.paused =
                false;

            this.emit(true);

            return this.getState();
        }


        stop() {

            this.started =
                false;

            this.paused =
                false;

            this.emit(true);

            return this.getState();
        }


        pause() {

            this.paused =
                true;

            this.emit(true);

            return this.getState();
        }


        resume() {

            this.paused =
                false;

            this.started =
                true;

            this.emit(true);

            return this.getState();
        }


        destroy() {

            this.stop();

            this.destroyed =
                true;

            this.listeners.clear();

        }


        /* ======================================================
         * EVENTS
         * ====================================================== */

        on(listener) {

            if (
                typeof listener !==
                "function"
            ) {

                return () => {};

            }


            this.listeners.add(
                listener
            );


            return () =>
                this.off(listener);
        }


        off(listener) {

            this.listeners.delete(
                listener
            );

        }


        emit() {

            const state =
                this.getState();


            for (
                const listener of
                this.listeners
            ) {

                try {

                    listener(state);

                } catch (error) {

                    console.warn(
                        "Engine listener error:",
                        error
                    );

                }

            }


            if (
                typeof global.dispatchEvent ===
                "function"
            ) {

                try {

                    global.dispatchEvent(
                        new CustomEvent(
                            "gtrader:state",
                            {
                                detail: state
                            }
                        )
                    );

                } catch (_) {}

            }

        }


        /* ======================================================
         * MODULE REGISTRY
         * ====================================================== */

        registerModule(
            name,
            module
        ) {

            if (
                !name ||
                !module
            ) {

                return false;

            }


            this.modules[name] =
                module;


            return true;
        }
                loadExternalModules() {

            const moduleNames = [

                "patterns",
                "probability",
                "statistics",
                "transition",
                "markov",
                "cycle",
                "confidence",
                "validator",
                "decision",
                "learning"

            ];


            for (
                const name of
                moduleNames
            ) {

                const candidate =
                    global[
                        name +
                        "Engine"
                    ] ||
                    global[
                        name +
                        "Module"
                    ] ||
                    global[name];


                if (
                    candidate
                ) {

                    this.registerModule(
                        name,
                        candidate
                    );

                }

            }


            /*
             * Also support modules that expose
             * an already-created instance.
             */

            if (
                global.patternsEngine
            ) {

                this.registerModule(
                    "patterns",
                    global.patternsEngine
                );

            }


            if (
                global.probabilityEngine
            ) {

                this.registerModule(
                    "probability",
                    global.probabilityEngine
                );

            }


            if (
                global.statisticsEngine
            ) {

                this.registerModule(
                    "statistics",
                    global.statisticsEngine
                );

            }


            if (
                global.transitionEngine
            ) {

                this.registerModule(
                    "transition",
                    global.transitionEngine
                );

            }


            if (
                global.markovEngine
            ) {

                this.registerModule(
                    "markov",
                    global.markovEngine
                );

            }


            if (
                global.cycleEngine
            ) {

                this.registerModule(
                    "cycle",
                    global.cycleEngine
                );

            }


            if (
                global.confidenceEngine
            ) {

                this.registerModule(
                    "confidence",
                    global.confidenceEngine
                );

            }


            if (
                global.validatorEngine
            ) {

                this.registerModule(
                    "validator",
                    global.validatorEngine
                );

            }


            if (
                global.decisionEngine
            ) {

                this.registerModule(
                    "decision",
                    global.decisionEngine
                );

            }


            if (
                global.learningEngine
            ) {

                this.registerModule(
                    "learning",
                    global.learningEngine
                );

            }

        }


        /* ======================================================
         * MARKET MANAGEMENT
         * ====================================================== */

        initializeMarkets() {

            for (
                const market of
                this.markets
            ) {

                this.ensureMarketState(
                    market
                );

            }

        }


        addMarket(
            symbol
        ) {

            if (
                !symbol ||
                this.markets.includes(
                    symbol
                )
            ) {

                return false;

            }


            this.markets.push(
                symbol
            );


            this.ensureMarketState(
                symbol
            );


            return true;
        }


        removeMarket(
            symbol
        ) {

            if (
                this.markets.length <= 1
            ) {

                return false;

            }


            const index =
                this.markets.indexOf(
                    symbol
                );


            if (
                index === -1
            ) {

                return false;

            }


            this.markets.splice(
                index,
                1
            );


            delete this.marketStates[
                symbol
            ];


            delete this.analysis[
                symbol
            ];


            if (
                this.activeMarket ===
                symbol
            ) {

                this.activeMarket =
                    this.markets[0];

            }


            return true;
        }


        setActiveMarket(
            symbol
        ) {

            if (
                !this.markets.includes(
                    symbol
                )
            ) {

                this.addMarket(
                    symbol
                );

            }


            this.activeMarket =
                symbol;


            this.ensureMarketState(
                symbol
            );


            return symbol;
        }


        ensureMarketState(
            symbol
        ) {

            if (
                !this.marketStates[
                    symbol
                ]
            ) {

                this.marketStates[
                    symbol
                ] = {

                    symbol,

                    ticks: 0,

                    lastQuote: null,

                    lastDigit: null,

                    signal: "WAIT",

                    recommendation:
                        "Analyzing...",

                    confidence: 0,

                    prediction: null,

                    predictionType:
                        null,

                    analysis: null,

                    updatedAt: null

                };

            }


            return this.marketStates[
                symbol
            ];
        }


        getMarketState(
            symbol
        ) {

            return this.ensureMarketState(
                symbol
            );
        }


        getAllMarketStates() {

            const result =
                {};


            for (
                const market of
                this.markets
            ) {

                result[market] =
                    {
                        ...this.getMarketState(
                            market
                        )
                    };

            }


            return result;
        }


        /* ======================================================
         * TICK PROCESSING
         * ====================================================== */

        ingestTick(
            tick,
            market = this.activeMarket
        ) {

            if (
                !tick ||
                this.paused
            ) {

                return null;

            }


            const normalized =
                this.normalizeTick(
                    tick,
                    market
                );


            if (
                !normalized
            ) {

                this.lastError =
                    "Invalid tick";

                return null;

            }


            const state =
                this.ensureMarketState(
                    market
                );


            state.ticks++;

            state.lastQuote =
                normalized.quote;

            state.lastDigit =
                normalized.digit;

            state.updatedAt =
                normalized.time;


            this.updateMemory(
                normalized
            );


            const analysis =
                this.analyzeMarket(
                    market
                );


            const decision =
                this.makeDecision(
                    market,
                    analysis
                );


            state.signal =
                decision.signal;

            state.recommendation =
                decision.recommendation;

            state.confidence =
                decision.confidence;

            state.prediction =
                decision.prediction;

            state.predictionType =
                decision.predictionType;

            state.analysis =
                analysis;


            this.pendingSignals[
                market
            ] =
                decision;


            this.emit();


            return decision;
        }


        addTick(
            tick,
            market
        ) {

            return this.ingestTick(
                tick,
                market
            );

        }


        processTick(
            tick,
            market
        ) {

            return this.ingestTick(
                tick,
                market
            );

        }


        normalizeTick(
            tick,
            market
        ) {

            let quote;

            let time =
                Date.now();

            let symbol =
                market;


            if (
                typeof tick ===
                "number"
            ) {

                quote =
                    tick;

            } else {

                quote =
                    tick.quote ??
                    tick.price ??
                    tick.value ??
                    tick.close;


                time =
                    tick.epoch ??
                    tick.time ??
                    tick.timestamp ??
                    Date.now();


                symbol =
                    tick.symbol ??
                    market;

            }


            const number =
                Number(
                    quote
                );


            if (
                !Number.isFinite(
                    number
                )
            ) {

                return null;

            }


            let digit =
                null;


            if (
                tick &&
                typeof tick ===
                "object" &&
                Number.isInteger(
                    tick.digit
                )
            ) {

                digit =
                    tick.digit;

            } else {

                digit =
                    this.extractDigit(
                        number
                    );

            }


            return {

                symbol,

                quote:
                    number,

                digit,

                time:
                    Number(time) ||
                    Date.now()

            };
                /* ======================================================
         * DIGIT MEMORY
         * ====================================================== */

        extractDigit(
            quote
        ) {

            const number =
                Number(
                    quote
                );


            if (
                !Number.isFinite(
                    number
                )
            ) {

                return null;

            }


            const fixed =
                Math.abs(
                    number
                ).toFixed(10);


            const parts =
                fixed.split(".");


            const decimals =
                parts[1] || "";


            if (
                decimals.length
            ) {

                return Number(
                    decimals[
                        decimals.length - 1
                    ]
                );

            }


            return Number(
                parts[0].slice(-1)
            );
        }


        updateMemory(
            tick
        ) {

            const digit =
                tick.digit;


            this.memory.previousDigit =
                this.memory.lastDigit;


            this.memory.lastDigit =
                digit;


            if (
                !Number.isInteger(
                    digit
                )
            ) {

                return;

            }


            this.memory.ticks.push(
                tick
            );


            this.memory.digits.push(
                digit
            );


            this.memory.frequencies[
                digit
            ]++;


            while (
                this.memory.ticks.length >
                this.config.maxTicks
            ) {

                this.memory.ticks.shift();


                const removed =
                    this.memory.digits.shift();


                if (
                    Number.isInteger(
                        removed
                    )
                ) {

                    this.memory.frequencies[
                        removed
                    ] =
                        Math.max(
                            0,
                            this.memory.frequencies[
                                removed
                            ] - 1
                        );

                }

            }

        }


        /* ======================================================
         * ANALYSIS PIPELINE
         * ====================================================== */

        analyzeAllMarkets() {

            for (
                const market of
                this.markets
            ) {

                this.analyzeMarket(
                    market
                );

            }

        }


        analyzeMarket(
            market
        ) {

            const digits =
                this.getMarketDigits(
                    market
                );


            if (
                digits.length <
                this.config.minAnalysisTicks
            ) {

                const empty =
                    this.emptyAnalysis(
                        digits.length
                    );


                this.analysis[
                    market
                ] =
                    empty;


                return empty;
            }


            const window =
                digits.slice(
                    -this.config.analysisWindow
                );


            const results =
                {};


            /*
             * Every module receives the SAME
             * digit window.
             */

            results.patterns =
                this.runModule(
                    "patterns",
                    window
                );


            results.probability =
                this.runModule(
                    "probability",
                    window
                );


            results.statistics =
                this.runModule(
                    "statistics",
                    window
                );


            results.transition =
                this.runModule(
                    "transition",
                    window
                );


            results.markov =
                this.runModule(
                    "markov",
                    window
                );


            results.cycle =
                this.runModule(
                    "cycle",
                    window
                );


            /*
             * Confidence receives the independent
             * module results.
             */

            results.confidence =
                this.runConfidence(
                    results
                );


            /*
             * Validation receives confidence plus
             * the independent results.
             */

            results.validation =
                this.runValidation(
                    results.confidence,
                    results
                );


            this.analysis[
                market
            ] = {

                market,

                sampleSize:
                    window.length,

                modules:
                    results,

                confidence:
                    results.confidence
                        ? results.confidence.confidence
                        : 0,

                prediction:
                    this.extractPrediction(
                        results.confidence
                    ),

                updatedAt:
                    Date.now()
            };


            return this.analysis[
                market
            ];
        }


        getMarketDigits(
            market
        ) {

            /*
             * The active market uses the live
             * memory collected by deriv.js/engine.
             */

            if (
                market ===
                this.activeMarket
            ) {

                return this.memory.digits;

            }


            const state =
                this.marketStates[
                    market
                ];


            if (
                state &&
                Array.isArray(
                    state.digits
                )
            ) {

                return state.digits;

            }


            return [];
        }


        /* ======================================================
         * MODULE RUNNER
         * ====================================================== */

        runModule(
            name,
            digits
        ) {

            const module =
                this.modules[
                    name
                ];


            if (
                !module
            ) {

                return {

                    module:
                        name,

                    success:
                        false,

                    score:
                        0,

                    prediction:
                        null,

                    reason:
                        "Module unavailable"

                };

            }


            try {

                if (
                    typeof module.analyze ===
                    "function"
                ) {

                    return module.analyze(
                        digits
                    );

                }


                if (
                    typeof module.run ===
                    "function"
                ) {

                    return module.run(
                        digits
                    );

                }


                return {

                    module:
                        name,

                    success:
                        false,

                    score:
                        0,

                    prediction:
                        null,

                    reason:
                        "No analyze/run method"

                };

            } catch (error) {

                return {

                    module:
                        name,

                    success:
                        false,

                    score:
                        0,

                    prediction:
                        null,

                    reason:
                        error.message

                };

            }

        }
                /* ======================================================
         * CONFIDENCE
         * ====================================================== */

        runConfidence(
            results
        ) {

            const module =
                this.modules[
                    "confidence"
                ];


            if (
                !module
            ) {

                return {

                    module:
                        "confidence",

                    success:
                        false,

                    confidence:
                        0,

                    score:
                        0,

                    prediction:
                        null,

                    reason:
                        "Confidence module unavailable"

                };

            }


            try {

                return module.analyze(

                    results.patterns,

                    results.probability,

                    results.statistics,

                    results.transition,

                    results.markov,

                    results.cycle

                );

            } catch (error) {

                return {

                    module:
                        "confidence",

                    success:
                        false,

                    confidence:
                        0,

                    score:
                        0,

                    prediction:
                        null,

                    reason:
                        error.message

                };

            }

        }


        /* ======================================================
         * VALIDATION
         * ====================================================== */

        runValidation(
            confidence,
            results
        ) {

            const module =
                this.modules[
                    "validator"
                ];


            if (
                !module
            ) {

                return {

                    module:
                        "validator",

                    valid:
                        false,

                    success:
                        false,

                    reason:
                        "Validator unavailable"

                };

            }


            try {

                if (
                    typeof module.validate ===
                    "function"
                ) {

                    return module.validate(
                        confidence,
                        results
                    );

                }


                return module.analyze(
                    confidence,
                    results
                );

            } catch (error) {

                return {

                    module:
                        "validator",

                    valid:
                        false,

                    success:
                        false,

                    reason:
                        error.message

                };

            }

        }


        /* ======================================================
         * FINAL DECISION
         * ====================================================== */

        makeDecision(
            market,
            analysis =
                this.analysis[
                    market
                ]
        ) {

            if (
                !analysis
            ) {

                return this.waitDecision(
                    "No analysis available"
                );

            }


            const confidence =
                analysis.modules &&
                analysis.modules.confidence;


            const validation =
                analysis.modules &&
                analysis.modules.validation;


            const moduleResults =
                analysis.modules ||
                {};


            const decisionModule =
                this.modules[
                    "decision"
                ];


            if (
                !decisionModule
            ) {

                return this.waitDecision(
                    "Decision module unavailable"
                );

            }


            let result;


            try {

                result =
                    decisionModule.analyze(

                        confidence,

                        validation,

                        moduleResults

                    );

            } catch (error) {

                return this.waitDecision(
                    error.message
                );

            }


            const prediction =
                this.extractPrediction(
                    result
                );


            const confidenceValue =
                this.getConfidence(
                    result,
                    confidence
                );


            const approved =
                result &&
                (
                    result.approved === true ||
                    result.signal === "TRADE"
                );


            return {

                market,

                signal:
                    approved
                        ? "TRADE"
                        : "WAIT",

                recommendation:
                    approved
                        ? "TRADE"
                        : "WAIT",

                confidence:
                    confidenceValue,

                prediction,

                predictionType:
                    "DIGIT",

                validation:
                    validation
                        ? !!validation.valid
                        : false,

                reason:
                    result &&
                    result.reason
                        ? result.reason
                        : "Waiting for confirmation",

                decision:
                    result,

                timestamp:
                    Date.now()

            };
        }


        waitDecision(
            reason
        ) {

            return {

                signal:
                    "WAIT",

                recommendation:
                    "WAIT",

                confidence:
                    0,

                prediction:
                    null,

                predictionType:
                    null,

                validation:
                    false,

                reason,

                timestamp:
                    Date.now()

            };

        }


        /* ======================================================
         * PREDICTION HELPERS
         * ====================================================== */

        extractPrediction(
            result
        ) {

            if (
                !result
            ) {

                return null;

            }


            if (
                Number.isInteger(
                    result.prediction
                )
            ) {

                return result.prediction;

            }


            if (
                result.prediction &&
                typeof result.prediction ===
                "object" &&
                Number.isInteger(
                    result.prediction.digit
                )
            ) {

                return result.prediction.digit;

            }


            if (
                Number.isInteger(
                    result.digit
                )
            ) {

                return result.digit;

            }


            return null;
        }


        getConfidence(
            decision,
            confidence
        ) {

            const value =
                decision &&
                (
                    decision.confidence ??
                    decision.score
                );


            if (
                Number.isFinite(
                    Number(value)
                )
            ) {

                return Number(value);

            }


            if (
                confidence &&
                Number.isFinite(
                    Number(
                        confidence.confidence ??
                        confidence.score
                    )
                )
            ) {

                return Number(
                    confidence.confidence ??
                    confidence.score
                );

            }


            return 0;
        }


        emptyAnalysis(
            sampleSize = 0
        ) {

            return {

                market:
                    this.activeMarket,

                sampleSize,

                modules: {},

                confidence:
                    0,

                prediction:
                    null,

                updatedAt:
                    Date.now()

            };

        }
                /* ======================================================
         * PAPER TRADING
         * ====================================================== */

        paperTrade(
            decision,
            actualDigit = null
        ) {

            if (
                !this.paper.enabled
            ) {

                return null;

            }


            if (
                !decision ||
                decision.signal !==
                "TRADE"
            ) {

                return null;

            }


            const stake =
                Math.min(

                    Number(
                        this.config.maxStake
                    ) || 0,

                    Math.max(
                        0,
                        this.paper.balance
                    )

                );


            if (
                stake <= 0
            ) {

                return null;

            }


            const prediction =
                decision.prediction;


            let result =
                "PENDING";


            let profit =
                0;


            if (
                Number.isInteger(
                    actualDigit
                ) &&
                Number.isInteger(
                    prediction
                )
            ) {

                if (
                    actualDigit ===
                    prediction
                ) {

                    result =
                        "WIN";

                    profit =
                        stake;

                    this.paper.wins++;

                } else {

                    result =
                        "LOSS";

                    profit =
                        -stake;

                    this.paper.losses++;

                }


                this.paper.balance +=
                    profit;

                this.paper.profit +=
                    profit;

            }


            this.paper.trades++;

            this.paper.stake =
                stake;


            const trade = {

                id:
                    Date.now(),

                market:
                    decision.market,

                prediction,

                actualDigit,

                stake,

                result,

                profit,

                confidence:
                    decision.confidence,

                timestamp:
                    Date.now()

            };


            this.paper.lastTrade =
                trade;


            this.tradeHistory.push(
                trade
            );


            /*
             * Feed the outcome back into
             * the learning module.
             */

            const learning =
                this.modules[
                    "learning"
                ];


            if (
                learning
            ) {

                try {

                    if (
                        result !==
                        "PENDING"
                    ) {

                        if (
                            typeof learning.recordOutcome ===
                            "function"
                        ) {

                            learning.recordOutcome(
                                result ===
                                    "WIN",
                                actualDigit
                            );

                        }

                    } else if (
                        typeof learning.analyze ===
                        "function"
                    ) {

                        learning.analyze(
                            decision,
                            {
                                market:
                                    decision.market
                            }
                        );

                    }

                } catch (_) {}

            }


            return trade;
        }


        /* ======================================================
         * PAPER TRADE OUTCOME
         * ====================================================== */

        resolvePaperTrade(
            actualDigit
        ) {

            const last =
                this.paper.lastTrade;


            if (
                !last ||
                last.result !==
                "PENDING"
            ) {

                return null;

            }


            return this.paperTrade(
                {
                    ...last,
                    signal:
                        "TRADE"
                },
                actualDigit
            );

        }


        /* ======================================================
         * MARKET SELECTION
         * ====================================================== */

        selectBestMarket() {

            if (
                !this.config.autoSelectMarket
            ) {

                return this.activeMarket;

            }


            let best =
                null;


            for (
                const market of
                this.markets
            ) {

                const state =
                    this.getMarketState(
                        market
                    );


                const confidence =
                    Number(
                        state.confidence
                    ) || 0;


                if (
                    !best ||
                    confidence >
                    best.confidence
                ) {

                    best = {

                        market,

                        confidence

                    };

                }

            }


            if (
                best
            ) {

                this.activeMarket =
                    best.market;

            }


            return this.activeMarket;
        }


        /* ======================================================
         * STATE
         * ====================================================== */

        getState() {

            return {

                version:
                    this.version,

                started:
                    this.started,

                paused:
                    this.paused,

                activeMarket:
                    this.activeMarket,

                markets:
                    [...this.markets],

                memory: {

                    tickCount:
                        this.memory.ticks.length,

                    digitCount:
                        this.memory.digits.length,

                    lastDigit:
                        this.memory.lastDigit,

                    previousDigit:
                        this.memory.previousDigit,

                    frequencies:
                        [
                            ...this.memory.frequencies
                        ]

                },

                paper:
                    {
                        ...this.paper
                    },

                marketStates:
                    this.getAllMarketStates(),

                analysis:
                    this.analysis,

                pendingSignals:
                    this.pendingSignals,

                lastError:
                    this.lastError

            };

        }


        /* ======================================================
         * RESET
         * ====================================================== */

        resetMemory() {

            this.memory = {

                ticks: [],

                digits: [],

                frequencies:
                    Array(10).fill(0),

                lastDigit: null,

                previousDigit: null

            };


            this.analysis =
                {};


            this.pendingSignals =
                {};


            this.emit(true);

        }


        resetPaper() {

            this.paper = {

                enabled:
                    !!this.config.paperTrading,

                balance:
                    Number(
                        this.config.startingBalance
                    ) || 0,

                initialBalance:
                    Number(
                        this.config.startingBalance
                    ) || 0,

                profit: 0,

                wins: 0,

                losses: 0,

                trades: 0,

                stake: 0,

                lastTrade:
                    null

            };


            this.tradeHistory =
                [];


            this.emit(true);

        }
                /* ======================================================
         * UTILITY FUNCTIONS
         * ====================================================== */

        getHistory() {

            return [
                ...this.tradeHistory
            ];

        }


        getAnalysis(
            market =
                this.activeMarket
        ) {

            return this.analysis[
                market
            ] || null;

        }


        getPendingSignal(
            market =
                this.activeMarket
        ) {

            return this.pendingSignals[
                market
            ] || null;

        }


        getModule(
            name
        ) {

            return this.modules[
                name
            ] || null;

        }


        getModuleStatus() {

            const status =
                {};


            for (
                const name of [
                    "patterns",
                    "probability",
                    "statistics",
                    "transition",
                    "markov",
                    "cycle",
                    "confidence",
                    "validator",
                    "decision",
                    "learning"
                ]
            ) {

                status[name] =
                    !!this.modules[
                        name
                    ];

            }


            return status;
        }


        /* ======================================================
         * DASHBOARD COMPATIBILITY
         * ====================================================== */

        updateDashboard() {

            const state =
                this.getState();


            if (
                typeof global.updateDashboard ===
                "function"
            ) {

                try {

                    global.updateDashboard(
                        state
                    );

                } catch (_) {}

            }


            if (
                typeof global.renderDashboard ===
                "function"
            ) {

                try {

                    global.renderDashboard(
                        state
                    );

                } catch (_) {}

            }


            return state;
        }


        /* ======================================================
         * SAFE NUMBER
         * ====================================================== */

        safeNumber(
            value,
            fallback = 0
        ) {

            const number =
                Number(value);


            if (
                !Number.isFinite(
                    number
                )
            ) {

                return fallback;

            }


            return number;

        }

    }


    /* ==========================================================
     * GLOBAL EXPORTS
     * ========================================================== */

    global.AnalysisEngine =
        AnalysisEngine;


    global.GTraderEngine =
        AnalysisEngine;


    global.analysisEngine =
        new AnalysisEngine();


    global.engine =
        global.analysisEngine;


    /*
     * Automatically initialize when the browser
     * has finished loading.
     */

    if (
        typeof global.addEventListener ===
        "function"
    ) {

        global.addEventListener(
            "load",
            function () {

                try {

                    if (
                        global.analysisEngine &&
                        !global.analysisEngine.started
                    ) {

                        global.analysisEngine.initialize();

                    }

                } catch (error) {

                    console.error(
                        "GTRADER engine initialization error:",
                        error
                    );

                }

            }
        );

    }

})(window);